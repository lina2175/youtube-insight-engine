# Backend only. Copy to .env at the repository root. No key is needed for the app or offline tests.
DATABASE_PATH=./.local/youtube-insight.sqlite3
CORS_ORIGINS=["http://127.0.0.1:5173"]
# Only the explicitly invoked extraction CLI needs these. Never use VITE_* for keys.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Extraction safety bounds; CLI sample defaults to 5 and cannot exceed this cap.
YOUTUBE_MAX_VIDEOS=100
YOUTUBE_TIMEOUT_SECONDS=10
YOUTUBE_MAX_RETRIES=2
YOUTUBE_BACKOFF_SECONDS=0.5
